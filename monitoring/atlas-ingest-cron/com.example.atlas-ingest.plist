<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.example.atlas-ingest</string>

	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>/path/to/dev-harness/monitoring/atlas-ingest-cron/atlas_ingest_cron.sh</string>
	</array>

	<key>StartInterval</key>
	<integer>21600</integer>

	<key>RunAtLoad</key>
	<true/>

	<key>StandardOutPath</key>
	<string>/path/to/dev-harness/logs/ingest-cron/launchd.out.log</string>

	<key>StandardErrorPath</key>
	<string>/path/to/dev-harness/logs/ingest-cron/launchd.err.log</string>

	<key>ProcessType</key>
	<string>Background</string>
</dict>
</plist>
